<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:App"
    xmlns:views="clr-namespace:App.Views"
    Title="App"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Начало работы"
        Route="WelcomePage"
        ContentTemplate="{DataTemplate views:WelcomePage}" />
    
    <ShellContent
        ContentTemplate="{DataTemplate views:WarehousePage}"
        Route="WarehousePage" />

    <ShellContent
        Title="Продажа"
        ContentTemplate="{DataTemplate views:SalePage}"
        Route="SalePage" />

    <ShellContent
        Title="Продажа"
        ContentTemplate="{DataTemplate views:HistoryPage}"
        Route="HistoryPage" />

</Shell>
