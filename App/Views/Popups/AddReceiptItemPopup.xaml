<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:App.ViewModels.Popups"
               x:Class="App.Views.Popups.AddReceiptItemPopup"
               x:DataType="vm:AddReceiptItemViewModel"
               xmlns:model="clr-namespace:App.Model"> <!-- Добавить ViewModel -->

    <VerticalStackLayout Padding="20" Spacing="15"
                     WidthRequest="600"
                     BackgroundColor="white">

        <Label Text="Добавить товар в приход"
           FontSize="20"
           FontAttributes="Bold"
           HorizontalOptions="Center" 
           TextColor="Black"/>

        <!-- Поля -->
        <VerticalStackLayout Spacing="5">
            <Label Text="Название:" FontAttributes="Bold"  TextColor="Black"/>
            <Entry Text="{Binding NameText}"
               TextColor="Black"
               Placeholder="Введите название" />
            <Label Text="{Binding NameError}" FontAttributes="Bold"  TextColor="Red"/>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5">
            <Label Text="Описание:" FontAttributes="Bold" TextColor="Black"/>
            <Editor Text="{Binding Description}"
                TextColor="Black"
                Placeholder="Описание товара"
                HeightRequest="80" />
            <Label Text="{Binding DescriptionError}" FontAttributes="Bold"  TextColor="Red"/>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5">
            <Label Text="Штрих-код:" FontAttributes="Bold" TextColor="Black"/>
            <HorizontalStackLayout>
                <Entry Text="{Binding BarcodeText}"
                       TextColor="Black"
                       Placeholder="4607176800081"
                       Keyboard="Numeric" />
            </HorizontalStackLayout>
            <Label Text="{Binding BarcodeError}" FontAttributes="Bold"  TextColor="Red"/>
        </VerticalStackLayout>

        <HorizontalStackLayout>
            <VerticalStackLayout
                 Padding="0,0,40,0">
                <Label Text="Количество:" FontAttributes="Bold" TextColor="Black"/>
                <Entry Text="{Binding Quantity}"
                    TextColor="Black"
                    Placeholder="1"/>
                <Label Text="{Binding QuantityError}" FontAttributes="Bold"  TextColor="Red"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Цена за ед.:" FontAttributes="Bold" TextColor="Black" Padding="0,0,0,3"/>
                <Border Stroke="#CCC"
                    StrokeThickness="1"
                    Padding="10,8"
                    BackgroundColor="#F5F5F5">
                            <Label Text="{Binding Price, StringFormat='{0:C}'}"
                       TextColor="Black"/>
                </Border>
            </VerticalStackLayout>
        </HorizontalStackLayout>

        <Border Grid.Row="2"
                IsVisible="{Binding HasSuggestions}"
                Stroke="#DDD"
                StrokeThickness="1"
                BackgroundColor="White">
            <CollectionView ItemsSource="{Binding Suggestions}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding SelectSuggestionCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:ProductSuggestion">
                        <Grid Padding="12,8" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="Gray"/>
                                <Label Text="{Binding Barcode}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding Price, StringFormat='{0:C}'}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
        
        <!-- Кнопки -->
        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
            <Button Grid.Column="0"
                Text="Отмена"
                Command="{Binding CloseCommand}"
                BackgroundColor="#6C757D"
                TextColor="White" />

            <Button Grid.Column="1"
                Text="Добавить"
                Command="{Binding AddCommand}"
                BackgroundColor="#28A745"
                TextColor="White" />
        </Grid>
    </VerticalStackLayout>

</toolkit:Popup>