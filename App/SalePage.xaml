<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.Views.SalePage"
             Title="SalePage">
    
    <Grid ColumnDefinitions="200, *">
        <!-- ═══════════════ ЛЕВОЕ МЕНЮ (статичное) ═══════════════ -->
        <Border Grid.Column="0"
        BackgroundColor="#2C3E50"
        StrokeThickness="0">
            <VerticalStackLayout Padding="10" Spacing="10">

                <!-- Заголовок -->
                <Label Text="Складской учет"
               TextColor="White"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,30" />

                <!-- Кнопка "Склад" -->
                <Button x:Name="InventoryButton"
                Text="📦 Склад"
                BackgroundColor="#34495E"
                TextColor="White"
                FontSize="16"
                HeightRequest="50"
                HorizontalOptions="Fill"
                CornerRadius="8" />

                <!-- Кнопка "Продажа" -->
                <Button x:Name="SaleButton"
                Text="💰 Продажа"
                BackgroundColor="#34495E"
                TextColor="White"
                FontSize="16"
                HeightRequest="50"
                HorizontalOptions="Fill"
                CornerRadius="8" />

            </VerticalStackLayout>
        </Border>

        <!-- ═══════════════ ОБЛАСТЬ КОНТЕНТА ═══════════════ -->
        <ContentView Grid.Column="1"
             x:Name="ContentArea">
            <!-- Сюда будем подставлять нужную страницу -->
        </ContentView>
    </Grid>
    
</ContentPage>